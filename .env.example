# Open-Meteo coordinates
WEATHER_LATITUDE=
WEATHER_LONGITUDE=

# SwitchBot OpenAPI credentials
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=

# Meter MAC/device ID without colons.
# App format: AA:BB:CC:DD:EE:FF
# API format: AABBCCDDEEFF
SWITCHBOT_DEVICE_ID=

# VeSync cloud credentials. Required only when a room uses provider "vesync".
# HUMIDIFIER_DEVICE_ID must be the humidifier CID exposed by VeSync.
VESYNC_USERNAME=
VESYNC_PASSWORD=
VESYNC_COUNTRY_CODE=DE
VESYNC_TIME_ZONE=Europe/Berlin
VESYNC_TIMEOUT_SECONDS=15

# Shared room registry. Ventilation uses only rooms with HAS_WINDOW=true.
# Humidifier control uses rooms with both provider and device ID configured.
# SWITCHBOT_DEVICE_ID above remains temporarily for the legacy single-room runner.
ROOM_COUNT=6

ROOM_1_ID=shower-bathroom
ROOM_1_DISPLAY_NAME=banheiro das criancas
ROOM_1_METER_ID=
ROOM_1_HAS_WINDOW=false
ROOM_1_HUMIDIFIER_PROVIDER=
ROOM_1_HUMIDIFIER_DEVICE_ID=

ROOM_2_ID=kitchen
ROOM_2_DISPLAY_NAME=cozinha
ROOM_2_METER_ID=
ROOM_2_HAS_WINDOW=false
ROOM_2_HUMIDIFIER_PROVIDER=
ROOM_2_HUMIDIFIER_DEVICE_ID=

ROOM_3_ID=living-room
ROOM_3_DISPLAY_NAME=sala de estar
ROOM_3_METER_ID=
ROOM_3_HAS_WINDOW=true
ROOM_3_HUMIDIFIER_PROVIDER=
ROOM_3_HUMIDIFIER_DEVICE_ID=

ROOM_4_ID=bathtub-bathroom
ROOM_4_DISPLAY_NAME=banheiro
ROOM_4_METER_ID=
ROOM_4_HAS_WINDOW=false
ROOM_4_HUMIDIFIER_PROVIDER=
ROOM_4_HUMIDIFIER_DEVICE_ID=

ROOM_5_ID=bedroom
ROOM_5_DISPLAY_NAME=quarto
ROOM_5_METER_ID=
ROOM_5_HAS_WINDOW=true
ROOM_5_HUMIDIFIER_PROVIDER=
ROOM_5_HUMIDIFIER_DEVICE_ID=

ROOM_6_ID=children-room
ROOM_6_DISPLAY_NAME=quarto das criancas
ROOM_6_METER_ID=
ROOM_6_HAS_WINDOW=true
ROOM_6_HUMIDIFIER_PROVIDER=
ROOM_6_HUMIDIFIER_DEVICE_ID=

# Humidifiers are controlled only during 11:30-14:00 and 19:00-08:00.
# Commands remain dry-run unless this explicit production gate is true.
HUMIDIFIER_ON_BELOW=45
HUMIDIFIER_OFF_AT=50
ALLOW_REAL_HUMIDIFIER_COMMANDS=false

# Voice Monkey
VOICE_MONKEY_API_TOKEN=
VOICE_MONKEY_OPEN_DEVICE_ID=
VOICE_MONKEY_CLOSE_DEVICE_ID=

# Persistent state inside the container (mount the host .state directory here).
NOTIFICATION_STATE_FILE=/app/.state/notifications.json

# Heating control. Each zone maps one Meter to one physical 2PM relay channel.
HEATING_MAXIMUM_READING_AGE_SECONDS=600
ALLOW_REAL_HEATING_COMMANDS=false
HEATING_SCHEDULED_ZONE=children-room

HEATING_ZONE_1_ENABLED=false
HEATING_ZONE_1_NAME=shower-bathroom
HEATING_ZONE_1_RELAY_ID=
HEATING_ZONE_1_CHANNEL=1
HEATING_ZONE_1_METER_ID=
HEATING_ZONE_1_TARGET_TEMPERATURE=20
HEATING_ZONE_1_HYSTERESIS=0.5

HEATING_ZONE_2_ENABLED=false
HEATING_ZONE_2_NAME=kitchen
HEATING_ZONE_2_RELAY_ID=
HEATING_ZONE_2_CHANNEL=2
HEATING_ZONE_2_METER_ID=
HEATING_ZONE_2_TARGET_TEMPERATURE=20
HEATING_ZONE_2_HYSTERESIS=0.5

HEATING_ZONE_3_ENABLED=false
HEATING_ZONE_3_NAME=living-room
HEATING_ZONE_3_RELAY_ID=
HEATING_ZONE_3_CHANNEL=1
HEATING_ZONE_3_METER_ID=
HEATING_ZONE_3_TARGET_TEMPERATURE=20
HEATING_ZONE_3_HYSTERESIS=0.5

HEATING_ZONE_4_ENABLED=false
HEATING_ZONE_4_NAME=bathtub-bathroom
HEATING_ZONE_4_RELAY_ID=
HEATING_ZONE_4_CHANNEL=2
HEATING_ZONE_4_METER_ID=
HEATING_ZONE_4_TARGET_TEMPERATURE=20
HEATING_ZONE_4_HYSTERESIS=0.5

HEATING_ZONE_5_ENABLED=false
HEATING_ZONE_5_NAME=bedroom
HEATING_ZONE_5_RELAY_ID=
HEATING_ZONE_5_CHANNEL=1
HEATING_ZONE_5_METER_ID=
HEATING_ZONE_5_TARGET_TEMPERATURE=20
HEATING_ZONE_5_HYSTERESIS=0.5

HEATING_ZONE_6_ENABLED=false
HEATING_ZONE_6_NAME=children-room
HEATING_ZONE_6_RELAY_ID=
HEATING_ZONE_6_CHANNEL=2
HEATING_ZONE_6_METER_ID=
HEATING_ZONE_6_TARGET_TEMPERATURE=20
HEATING_ZONE_6_HYSTERESIS=0.5
